# ---------------------------------------------------------------------------
# dev-center MCP Tools Dashboard — example environment
#
# Copy to `.env.local` and fill in real values there. `.env.local` is
# git-ignored; this file must never contain an actual token or setup code.
#
# The browser calls only the dashboard backend. MCP credentials are read by
# backend/mcp-service.mjs, never by a client bundle. Any variable prefixed with
# NEXT_PUBLIC_ IS inlined into the client bundle — never put a secret there.
# ---------------------------------------------------------------------------

# --- Public build-time configuration (safe, non-secret) --------------------

# NOTHING IN THIS FILE IS REQUIRED TO RUN THE SITE.
# `npm run dev` and `npm run build` work with no .env file at all: the dashboard
# runs standalone at the domain root. Without credentials, live cards show
# Not configured. No saved counts are presented as current.

# Sub-path the static export is served from. LEAVE EMPTY for the standalone site
# at "/" (the current default). Set it to "/mcp/dashboard" only when you actually
# want to deploy under that sub-path later.
NEXT_PUBLIC_BASE_PATH=

# Endpoint shown in the Connect page examples. DISPLAY ONLY — the browser never
# calls it. Override it only to document a different endpoint.
NEXT_PUBLIC_MCP_ENDPOINT=https://resource.casa/mcp


# --- Server-only live MCP configuration ----------------------------------
# Never prefixed with NEXT_PUBLIC_. Never logged, never rendered, never
# committed. Read only inside server-side code.

# Bearer token presented as `Authorization: Bearer $DEV_CENTER_TOKEN`.
DEV_CENTER_TOKEN=
# Production alternative: mount the existing server-managed token read-only.
# Configure either the value above OR this file path, never both.
DEV_CENTER_TOKEN_FILE=

# Second required header, sent as `X-Setup-Code: $DEV_CENTER_SETUP_CODE`.
# The endpoint rejects any request missing either of these two headers.
DEV_CENTER_SETUP_CODE=
DEV_CENTER_SETUP_CODE_FILE=

# Live discovery starts automatically when BOTH credentials are configured.
# SSH credentials are separate. Comma-separated endpoints of the SAME service:
# the card counts successful probes of this operator-configured list.
DEV_CENTER_MCP_URLS=https://resource.casa/mcp
# Optional allowlist for explicitly configured Docker service names when the
# dashboard and MCP server share a private network. Public HTTP remains blocked.
DEV_CENTER_MCP_HTTP_HOSTS=

# --- Read-only file service (server-only; never NEXT_PUBLIC_) ---------------
# No roots are exposed until an administrator supplies .files.local.json
# or FILES_CONFIG_PATH. See docs/files-backend.md for deployment and access control.
FILES_CONFIG_PATH=
# Production: authenticate viewers and inject this key into BOTH /api/files/*
# and /api/mcp/* requests. Never send this gateway key to the browser.
FILES_GATEWAY_KEY=
FILES_GATEWAY_KEY_FILE=
FILES_ACCESS_CONTROLLED=
FILES_ALLOWED_ORIGINS=
# Keep 127.0.0.1 locally. A container may use 0.0.0.0 only when it has no
# published port and is reachable solely from the authenticated proxy network.
FILES_HOST=
