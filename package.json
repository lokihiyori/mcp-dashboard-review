{
  "name": "mcp-tools-dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Production-ready dashboard for the dev-center MCP server: 14 tools, 3 categories, 1 endpoint.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "files:serve": "node backend/server.mjs",
    "test:files": "node --test backend/file-service.test.mjs",
    "test:mcp": "node --test backend/mcp-service.test.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "verify": "npm run lint && npm run typecheck && npm run build && npm run test && npm run test:files && npm run test:mcp"
  },
  "dependencies": {
    "lucide-react": "0.544.0",
    "next": "^15.5.25",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@tailwindcss/postcss": "4.1.13",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.18.1",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "9.35.0",
    "eslint-config-next": "^15.5.25",
    "jsdom": "26.1.0",
    "tailwindcss": "4.1.13",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
